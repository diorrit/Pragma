# ── AI API ─────────────────────────────────────────────────────────────────────
# Вставте ключ одного з провайдерів. Провайдер визначається автоматично по ключу:
#   sk-or-...   → OpenRouter  (підтримує GPT-4o, Claude, Gemini, Llama, ...)
#   sk-ant-...  → Anthropic   (Claude)
#   sk-...      → OpenAI      (GPT-4o, GPT-4o-mini)
#   AIzaSy...   → Gemini      (google.generativeai — прямий API)
#   решта       → Mistral     (якщо в моделі є mistral/pixtral)
AI_API_KEY=your_api_key_here

# Назва моделі (приклади):
#   gemini-2.5-flash                    ← Gemini direct
#   google/gemini-2.5-flash             ← OpenRouter / Gemini
#   openai/gpt-4o                       ← OpenRouter / OpenAI
#   anthropic/claude-3.5-sonnet         ← OpenRouter / Claude
#   mistral-large-latest                ← Mistral direct
#   pixtral-12b-2409                    ← Mistral vision direct
AI_MODEL=gemini-2.5-flash

# Глибина міркування для "thinking" моделей (none / low / medium / high)
REASONING_EFFORT=none

# ── Telegram (необов'язково) ───────────────────────────────────────────────────
# Якщо не заповнено — бот працює тільки через overlay.
BOT_TOKEN=your_telegram_bot_token_here
CHAT_ID=your_telegram_chat_id_here

# ── Гарячі клавіші ─────────────────────────────────────────────────────────────
# Формат pynput: <ctrl>+<f1>  або  <ctrl>+<shift>+<f12>
HOTKEY=<ctrl>+<f1>
QUIT_HOTKEY=<ctrl>+<alt>+<shift>+q
